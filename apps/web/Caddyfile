{
	# This container runs BEHIND the shared reverse proxy (/opt/proxy →
	# proxy-caddy) which owns the host's :80/:443 and terminates TLS with the
	# Cloudflare origin cert. So this Caddy is a plain-HTTP upstream on :80 and
	# routes purely by Host header. `auto_https off` because it must never try
	# ACME (it can't — it doesn't own the ports, and issuance fails behind
	# Cloudflare) and must never 308 :80→:443 (that loops behind Cloudflare).
	auto_https off
}

# ─────────────────────────────────────────────────────────────────────
# Container-local health probe (compose healthcheck hits http://localhost).
# ─────────────────────────────────────────────────────────────────────
http://localhost {
	respond /healthz "ok" 200
}

# ─────────────────────────────────────────────────────────────────────
# Marketing site — runmycrew.com
# Reverse-proxies to the Next.js standalone server in the `site`
# container. The product app lives on the `app.` subdomain.
# ─────────────────────────────────────────────────────────────────────
http://runmycrew.com {
	encode zstd gzip

	header {
		# TLS is terminated at Cloudflare, so HSTS is still correct to send.
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# Container-local health probe so the compose healthcheck never
	# depends on the marketing site being up.
	@healthz path /healthz
	handle @healthz {
		respond "ok" 200
	}

	# Everything else → Next.js standalone server.
	reverse_proxy site:3100 {
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 10s
			response_header_timeout 30s
		}
	}
}

# ─────────────────────────────────────────────────────────────────────
# Product app — app.runmycrew.com
# Caddy serves the static React build + reverse-proxies `/api/*`,
# `/ws/*`, `/health`, etc. to the FastAPI container.
# ─────────────────────────────────────────────────────────────────────
http://app.runmycrew.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	@healthz path /healthz
	handle @healthz {
		respond "ok" 200
	}

	# ── Backend routes (terminal) ───────────────────────────────────
	@api path /api/* /ws/* /openapi.json /docs /docs/* /redoc /redoc/* /health
	handle @api {
		reverse_proxy api:8000 {
			header_up X-Real-IP {remote_host}
			transport http {
				read_buffer 64KB
				write_buffer 64KB
				dial_timeout 10s
				response_header_timeout 60s
			}
		}
	}

	# ── Static frontend (everything else, terminal) ─────────────────
	handle {
		root * /srv

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		@index path / /index.html
		header @index Cache-Control "no-cache, no-store, must-revalidate"

		try_files {path} /index.html
		file_server
	}
}

# ─────────────────────────────────────────────────────────────────────
# www → apex canonical redirect. Cloudflare serves the browser over
# HTTPS; the redirect target is the https apex.
# ─────────────────────────────────────────────────────────────────────
http://www.runmycrew.com {
	redir https://runmycrew.com{uri} permanent
}
